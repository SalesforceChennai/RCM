# Server Environment Configuration
PORT=5000

# PostgreSQL Connection String
DATABASE_URL=postgresql://postgres:<PASSWORD>@localhost:5432/rcm_database

# Individual PostgreSQL Parameters (Optional fallback if DATABASE_URL is not set)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=<PASSWORD>
PGDATABASE=rcm_database

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE_MINUTES=60

# Optional: Groq AI for Medical Coding Assistant
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
